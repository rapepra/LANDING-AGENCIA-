# Presupuesta Estudios · si Hostinger ya tiene un .htaccess, junta las reglas en vez de sustituirlo
ErrorDocument 404 /404.html
RewriteEngine On

# Esta carpeta está en public_html/landing_agencia: si alguien entra por presupuesta.net/landing_agencia/,
# se le manda a estudios.presupuesta.net (evita la web duplicada en otro dominio)
RewriteCond %{HTTP_HOST} ^(www\.)?presupuesta\.net$ [NC]
RewriteRule ^(.*)$ https://estudios.presupuesta.net/$1 [L,R=301]

# Todo por HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /index.html y /carpeta/index.html → URL limpia. Se mira la petición original del navegador
# (THE_REQUEST) para no entrar en bucle con la petición interna que hace el servidor al abrir "/".
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [L,R=301]

# Documentos internos: nunca se sirven, aunque se suban por error
RewriteRule ^interno(/|$) - [R=404,L]
RewriteRule \.md$ - [R=404,L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|png|svg|webp|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddType text/plain .txt
AddCharset utf-8 .txt .html .css
